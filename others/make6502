
.PHONY: run dbg
run:
	cat bootstrap_6502.fs | ./run6502 -l 1000 hoge.bin -P f001 -G f004 -X f002 -R 1000
	@echo '          00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F'
	@xxd -g1 mpu6502.dump | grep 000000d0:

dbg:
	acme -r dbg.lst -o dbg.bin planck.6502.s
	cat bootstrap_6502.fs | ./run6502 -l 1000 dbg.bin -P f001 -G f004 -X f002 -R 1000
	@echo '          00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F'
	@xxd -g1 mpu6502.dump | grep 000000d0:
